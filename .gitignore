# Ignore all image files
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.svg
*.tiff

# But keep the JSON files and PWA icons
!*.json
!icons/**
!public/**

# Hidden albums (prefixed with _) - synced to R2 only, never committed or deployed
albums/_*/

# Node modules
node_modules/

# Keep dist for GitHub Pages deployment
# dist/
